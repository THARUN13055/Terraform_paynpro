# Default behavior for line endings
* text=auto

# Explicitly declare text files for normalization
*.tf text
*.json text
*.yaml text
*.yml text
*.md text
*.sh text
*.env text

# Declare binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary

# Mark specific files and directories for special handling
LICENSE linguist-documentation=false
README.md linguist-documentation=true

# Treat Terraform files as HCL (HashiCorp Configuration Language)
*.tf linguist-language=HCL

# Sample vendored and generated files (update these as needed for your project)
# Adjust paths according to your specific project structure

# Mark the architecture image as a binary file
architecture.jpeg binary

# Mark auto-generated files
modules/**/output.tf linguist-generated
modules/**/variable.tf linguist-generated

# Vendored directories (examples, adjust as needed)
modules/Auto_Scaling_Groups/ASG/** linguist-vendored
modules/Database/Mysql_database/** linguist-vendored

# Detectable files
terraform_script/install_code_deploy.sh linguist-detectable=true
